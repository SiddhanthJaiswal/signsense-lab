{
  "name": "signsense-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n motion,web \"npm run dev:motion\" \"npm run dev:web\"",
    "dev:web": "vite --config apps/web/vite.config.ts --host 127.0.0.1",
    "dev:motion": ".venv/bin/python -m uvicorn services.motion.src.app:app --host 127.0.0.1 --port 8000",
    "build": "tsc --noEmit && vite build --config apps/web/vite.config.ts",
    "test": "node --experimental-strip-types --test apps/web/tests/*.test.ts && .venv/bin/python -m pytest services/motion/tests -q"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "5.2.8",
    "@fontsource-variable/newsreader": "5.2.8",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "@types/three": "0.180.0",
    "@vitejs/plugin-react": "5.0.4",
    "concurrently": "^9.2.5",
    "typescript": "5.9.3",
    "vite": "^7.3.7"
  }
}
